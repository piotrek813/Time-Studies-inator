{
  "name": "time-studies",
  "version": "1.0.28",
  "description": "Cycle Time Analyzer for Manufacturing Recordings",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "npm version patch --no-git-tag-version && git add . && git commit -m '%npm_package_version%' && git push",
    "build": "npx electron-builder"
  },
  "build": {
    "appId": "com.danfoss.timestudies",
    "productName": "Cycle Time Analyzer",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "avi",
          "mov",
          "mkv",
          "wmv",
          "flv",
          "webm",
          "m4v"
        ],
        "name": "Video Recording File",
        "role": "Viewer"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.2.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
